{
  "name": "@seginfo/secure-scan",
  "version": "0.1.0",
  "description": "Modular security scanner: SCA + Secrets + IaC",
  "private": true,
  "type": "module",
  "bin": {
    "secure-scan": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "scan": "tsx src/cli.ts",
    "scan:ci": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "glob": "^14.0.6",
    "js-yaml": "^4.1.0",
    "minimatch": "^11.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
